# Базовый URL — используется в canonical, sitemap, robots и Steam OpenID
NEXT_PUBLIC_SITE_URL=https://major.kg

# Подпись сессионной cookie (обязательно задать в проде)
SESSION_SECRET=change-me-to-a-long-random-string

# Steam Web API — только для подтягивания ника и аватара после входа.
# Сам вход через OpenID 2.0 работает и без ключа.
# Получить: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# FACEIT Data API — живое ELO и уровень игроков.
# Без ключа интерфейс показывает локальный снимок рейтингов.
# Получить: https://developers.faceit.com
FACEIT_API_KEY=

# Подтверждение прав на домен в поисковых системах
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Внешние ссылки сообщества (Discord — основной канал связи по матчам)
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/ваш-инвайт
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_TWITCH_URL=
NEXT_PUBLIC_YOUTUBE_URL=
