# Переменные сборки и порты для docker-compose.prod.yml.
# На сервере скопировать в .env рядом с docker-compose.prod.yml.
#
# Тут нет секретов: NEXT_PUBLIC_* попадают в браузерный бандл.
# Ключи и пароли живут в backend/.env.

# Порты на 127.0.0.1, которые слушают контейнеры. Менять, если заняты
# (проверить: ss -ltnp | grep -E '3100|4100').
WEB_PORT=3100
API_PORT=4100

# Публичный адрес сайта — canonical, sitemap, robots, SEO-разметка.
NEXT_PUBLIC_SITE_URL=https://major.kg

# true только если в backend/.env задан FACEIT_API_KEY: флаг управляет
# подписью «живое ELO» под таблицами рейтингов.
NEXT_PUBLIC_FACEIT_LIVE=false

# Ссылки сообщества в футере и на странице FAQ.
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Подтверждение прав на домен в поисковиках.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
