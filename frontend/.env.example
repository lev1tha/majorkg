# Базовый URL сайта — используется в canonical, sitemap, robots и SEO-разметке
NEXT_PUBLIC_SITE_URL=https://major.kg

# Адрес бэкенда. Server Components ходят туда напрямую, а браузерные
# запросы Next.js проксирует с /api/* (см. rewrites в next.config.mjs).
API_INTERNAL_URL=http://localhost:4000

# Живое ELO включается ключом FACEIT на стороне бэкенда. Здесь — только
# флаг для честной подписи под таблицами рейтингов.
NEXT_PUBLIC_FACEIT_LIVE=false

# Подтверждение прав на домен в поисковых системах
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Внешние ссылки сообщества (Discord — основной канал связи по матчам)
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/ваш-инвайт
NEXT_PUBLIC_TELEGRAM_URL=
