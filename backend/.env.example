# Порт API
PORT=4000

# Публичный origin фронтенда — куда Steam возвращает игрока после входа
SITE_URL=http://localhost:3000

# Публичный origin самого API — используется в openid.return_to
API_URL=http://localhost:4000

# Кому разрешено обращаться к API с cookie (через запятую)
CORS_ORIGINS=http://localhost:3000

# Файл базы SQLite (создается автоматически)
DATABASE_URL=./data/majorkg.db

# Подпись cookie — и игроков, и организаторов. В production обязательно задать.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Первая учетка организатора: создается при сиде, если админов еще нет.
# Вход в админку — по логину и паролю, Steam там не участвует.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Steam Web API — необязателен. Вход, ник и аватар работают и без него:
# ник и аватар берутся из публичного XML-профиля Steam. С ключом основным
# источником становится Web API, XML остается запасным.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# FACEIT Data API — живое ELO и уровень игроков.
# Без ключа отдается снимок из базы.
# https://developers.faceit.com
FACEIT_API_KEY=
