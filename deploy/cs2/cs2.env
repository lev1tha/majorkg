# Токены GSLT — по одному на инстанс: Valve не разрешает делить токен
# между серверами, второй сервер с тем же токеном просто не стартует.
#
# Получить: https://steamcommunity.com/dev/managegameservers  (App ID 730)
# Положить как /etc/default/cs2 и закрыть от чужих глаз:
#   chmod 600 /etc/default/cs2
#
# Имя переменной должно совпадать с номером инстанса: cs2@1 возьмет GSLT_1.

GSLT_1=
GSLT_2=
